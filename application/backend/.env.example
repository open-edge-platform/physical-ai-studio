# Physical AI Studio backend environment variables.
# Copy this file to `.env` in this directory and fill in the values you need.

# Application
DEBUG=false
ENVIRONMENT=dev
# Directory for datasets, models, snapshots, cache, logs, and the database.
# Defaults to a platform-appropriate app-data directory when unset.
# STORAGE_DIR=
# Directory containing a prebuilt web UI to serve as static files (optional).
# STATIC_FILES_DIR=

# Data import/upload safety (shared for dataset/model/project imports)
# DATA_IMPORT_MAX_UNCOMPRESSED_BYTES=214748364800
# DATA_IMPORT_MAX_UPLOAD_BYTES=107374182400
# DATA_IMPORT_MIN_FREE_BYTES=1073741824

# Remote training (studio side): submitting jobs to a trainer registered in
# the Studio UI/API.
# Seconds to wait for trainer HTTP requests (excludes long-poll/SSE streams).
# TRAINER_REQUEST_TIMEOUT_S=30.0
# Seconds to wait between chunks while streaming the model artifact.
# TRAINER_DOWNLOAD_READ_TIMEOUT_S=120.0

# Server
HOST=0.0.0.0
PORT=7860
# Overrides PORT when set (used by some deployment environments).
# HTTP_SERVER_PORT=

# Trainer service (application/backend/src/trainer): only needed on a machine
# that serves remote training jobs over HTTP via `physicalai-trainer`. Studio's
# own local training does not read these: it trains in-process. Prefixed with
# TRAINER_ so one file can configure both the studio and the trainer without
# the trainer binding the studio's port or writing into the studio's storage
# directory.
# Working directory for snapshots, checkpoints, and model archives.
# Defaults to ~/.local/share/physicalai-trainer when unset.
# TRAINER_STORAGE_DIR=
# TRAINER_HOST=0.0.0.0
# TRAINER_PORT=8001
# Concurrency cap for the trainer's queue worker (1-8). Defaults to a single GPU job.
# TRAINER_MAX_CONCURRENT_JOBS=1
# Uploaded-dataset safety bounds (http transfer) on the trainer side. Mirror
# the studio's own data-import guards above so a malicious or corrupt upload
# cannot exhaust the trainer's disk.
# TRAINER_MAX_UNCOMPRESSED_BYTES=214748364800
# TRAINER_MIN_FREE_BYTES=1073741824

# Database
# DATABASE_FILE=physicalai.db
DB_ECHO=false
# Allow startup when the database references an Alembic revision that is not
# available on the current branch. Migrations are still attempted and startup
# continues only if Alembic fails to locate that revision. Use only as an
# explicit recovery option for a known-compatible database.
ALLOW_UNKNOWN_DB_REVISION=false

# Alembic
# ALEMBIC_CONFIG_PATH=src/alembic.ini
# ALEMBIC_SCRIPT_LOCATION=src/alembic

# Proxy settings
no_proxy=localhost,127.0.0.1,::1

# Hugging Face token, used by the remote training backend to authenticate
# dataset/model uploads. Never commit a real token to source control.
HF_TOKEN=
