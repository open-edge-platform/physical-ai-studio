{
    "name": "physicalai-studio-ui",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24.2.0",
        "npm": ">=11.14.0"
    },
    "scripts": {
        "build": "rsbuild build",
        "build:api": "npx openapi-typescript ./src/api/openapi-spec.json -o ./src/api/openapi-spec.d.ts  --root-types && prettier --write src/api/openapi-spec.d.ts",
        "build:api:download": "curl -o ./src/api/openapi-spec.json http://localhost:7860/api/openapi.json && prettier --write src/api/openapi-spec.json",
        "cyclic-deps-check": "npx madge --circular src/**/*.ts*",
        "start": "rsbuild dev",
        "format": "prettier --write .",
        "format:check": "prettier --check --cache \"./src/**/*.{js,ts,jsx,tsx,css}\"",
        "lint": "eslint \"src/**/*.ts*\" --max-warnings 0",
        "lint:fix": "eslint --fix \"./src/**/*.ts*\"",
        "preview": "rsbuild preview",
        "test:unit": "rstest --config rstest.config.ts",
        "test:unit:watch": "rstest --config rstest.config.ts --reporters verbose --watch",
        "test:component": "npx playwright test --config=playwright.config.ts",
        "type-check": "tsc --noEmit"
    },
    "dependencies": {
        "@adobe/react-spectrum": "^3.41.0",
        "@geti-ui/blocks": "^1.1.2",
        "@geti-ui/ui": "^1.1.2",
        "@react-three/drei": "^10.7.9",
        "@react-three/fiber": "^9.8.1",
        "@scalar/api-reference-react": "^0.9.78",
        "@tanstack/react-query": "^5.101.3",
        "@types/three": "^0.186.0",
        "clsx": "^2.1.1",
        "dockview": "^8.4.1",
        "dockview-react": "^8.4.1",
        "lodash-es": "^4.18.1",
        "openapi-fetch": "^0.17.0",
        "openapi-react-query": "^0.5.4",
        "react": "^19.3.0",
        "react-aria-components": "^1.8.0",
        "react-dom": "^19.3.0",
        "react-error-boundary": "^6.1.6",
        "react-resizable-panels": "^4.14.2",
        "react-router": "^8.4.0",
        "react-use-websocket": "^4.13.0",
        "recharts": "^3.10.1",
        "sonner": "^2.0.8",
        "static-path": "^0.0.4",
        "three": "^0.186.1",
        "urdf-loader": "^0.13.1",
        "uuid": "^14.0.2"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.1",
        "@eslint/js": "^9.39.5",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@msw/playwright": "^0.7.0",
        "@msw/source": "^0.7.0",
        "@playwright/test": "^1.63.0",
        "@rsbuild/core": "^2.2.11",
        "@rsbuild/plugin-react": "^2.1.1",
        "@rsbuild/plugin-svgr": "^2.0.5",
        "@rstest/adapter-rsbuild": "^0.12.3",
        "@rstest/core": "^0.12.3",
        "@tanstack/eslint-plugin-query": "^5.101.3",
        "@testing-library/jest-dom": "^7.0.0",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/lodash-es": "^4.17.12",
        "@types/node": "^26.6.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/three": "^0.186.0",
        "@types/uuid": "^11.0.0",
        "@typescript-eslint/eslint-plugin": "^8.71.1",
        "@typescript-eslint/parser": "^8.71.1",
        "eslint": "^9.39.5",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-header": "^3.1.1",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-playwright": "^2.12.1",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-compiler": "^19.1.0-rc.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.13.0",
        "identity-obj-proxy": "^3.0.0",
        "jsdom": "^29.1.1",
        "msw": "^3.0.2",
        "node-fetch": "^3.3.2",
        "openapi-msw": "^2.1.0",
        "openapi-typescript": "^7.13.0",
        "prettier": "^3.9.9",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.71.1"
    }
}
