# Physical AI Trainer — standalone Docker Compose environment
#
# Copy this file to .env.trainer, edit the values below, then run:
#   docker compose -f docker-compose.trainer.yaml --profile cuda up -d
#   docker compose -f docker-compose.trainer.yaml --profile xpu up -d
#
# See application/backend/docs/remote-trainer.md for the manual-startup guide.

# Container image registry and version tag.
# `main` tracks the newest build from the main branch and is the right default
# for a throwaway environment. Set TRAINER_IMAGE_TAG to an immutable
# `<version>-dev-<short-sha>` tag or a resolved digest before using this in
# anything but a throwaway environment; `main` moves with every build.
# No `latest` tag is published: there is no release trigger yet, so every
# published trainer image is a development build.
REGISTRY=ghcr.io/open-edge-platform/
TRAINER_IMAGE_TAG=main

# Host port to publish. Always bound to 127.0.0.1 by docker-compose.trainer.yaml
# because the trainer has no built-in authentication.
TRAINER_PORT=8001

# Hugging Face token. Set only when training a policy that downloads
# gated/private model weights. Keep this out of version control.
HF_TOKEN=

# --- Intel XPU profile only ---
# Required when using --profile xpu. Host Intel GPU render node and its
# numeric group, so the non-root trainer user can access it. Find the render
# node with:
#   ls /dev/dri/renderD*
# and its GID with:
#   stat -c '%g' /dev/dri/renderD128
#RENDER_NODE=/dev/dri/renderD128
#RENDER_GID=

# Corporate proxies
# If your network requires a proxy, set these before building or starting
# the container.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
http_proxy=
https_proxy=
no_proxy=
